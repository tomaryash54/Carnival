# PostgreSQL connection string for Prisma
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# SMTP credentials for email notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="Vertex Solutions" <noreply@example.com>

# Comma-separated list of notification recipients
QUERY_NOTIFICATION_EMAILS=admin@example.com,sales@example.com,manager@example.com

# Public site config used for maps or metadata
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d...placeholder...
NEXT_PUBLIC_SITE_URL=http://localhost:3000
